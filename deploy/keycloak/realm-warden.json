{
  "realm": "warden",
  "enabled": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "groups": [
    { "name": "admins" },
    { "name": "sre" },
    { "name": "dev" }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@warden.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "groups": ["/admins", "/sre"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@warden.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Dev",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "groups": ["/dev"]
    }
  ],
  "clients": [
    {
      "clientId": "warden-proxy",
      "name": "Warden Proxy",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["https://auth.warden.localhost:8443/.warden/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://auth.warden.localhost:8443/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ]
}
